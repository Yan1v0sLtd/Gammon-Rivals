---
import SiteLayout from '../layouts/SiteLayout.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import BoardStrip from '../components/BoardStrip.astro'
import { site } from '../config/site'
import '../styles/doc.css'
---

<!-- Feature cards and board previews live in FeatureGrid / BoardStrip.
     Board previews, lobby icons, and the tutorial card are shared game
     imagery — reference by stable public URL, never copy into imported/. -->
<SiteLayout
  title={`How to Play — ${site.name}`}
  description={`Learn how ${site.name} works: roll dice, race your checkers home, and win matches against real players or AI opponents across five difficulty tiers.`}
  ogDescription={`Roll dice, race your checkers, win the match. Here's how ${site.name} works.`}
  canonical={`${site.url}/how-to-play`}
  ogImage="/lobby/backgrounds/classic-green.webp"
>
  <div class="doc-page">
    <!-- Inner max-width container so the scoped style below can size it. -->
    <div class="how-to-play-inner">
      <div class="feature-intro">
        <h1>How to Play</h1>
        <p>
          {site.name} is classic backgammon, reimagined for quick matches on your phone.
          Roll the dice, race your fifteen checkers around the board and home, and be the
          first to bear them all off. Play against real opponents online, or an AI
          opponent when no one else is available — either way, every match plays by the
          same rules.
        </p>
      </div>

      <div class="tutorial-figure">
        <img
          src="/lobby/cards/how-to-play-popup.webp"
          alt={`${site.name} tutorial: how dice, checkers, and the doubling cube work on the board`}
          loading="lazy"
        />
      </div>

      <FeatureGrid />

      <BoardStrip />

      <div class="doc-cta">
        <p>
          Still have a question about a rule, the doubling cube, or your
          balance? <a href="/support">Write to us</a> &mdash; a real person
          answers.
        </p>
      </div>
    </div>
  </div>
</SiteLayout>

<style>
  .how-to-play-inner {
    width: 100%;
    max-width: 64rem;
  }

  .feature-intro {
    max-width: 40rem;
    margin: 0 auto 2.4rem;
    text-align: center;
  }
  .feature-intro p { font-size: 1.02rem; }

  .tutorial-figure {
    max-width: 48rem;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .tutorial-figure img {
    width: 100%;
    border-radius: 0.85rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  .doc-cta {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }

  .feature-intro h1 {
    color: var(--site-gold);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin-bottom: 0.9rem;
  }

  .doc-cta p {
    margin-bottom: 0;
  }
  .doc-cta a { color: var(--site-gold); }
</style>
