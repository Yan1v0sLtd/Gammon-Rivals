---
import LegalLayout from '../layouts/LegalLayout.astro'
import ContactUs from '../components/ContactUs.astro'
import { site } from '../config/site'
import '../styles/doc.css'
---

<LegalLayout
  title={`Terms & Conditions — ${site.name}`}
  description={`Terms and Conditions for ${site.name}.`}
  canonical={`${site.url}/terms`}
>
  <h1>Terms &amp; Conditions</h1>
  <p class="doc-meta">
    Effective: {site.legalEffectiveDate} &middot; Operator: {site.legalName} &middot;
    {site.mailingAddress} &middot; <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
  </p>

