---
import LegalLayout from '../layouts/LegalLayout.astro'
import ContactUs from '../components/ContactUs.astro'
import { site } from '../config/site'
import '../styles/doc.css'
---

<!-- Static page — no form, no script, no API call. Email is the only support
     channel; account deletion keeps its own page. -->
<LegalLayout
  title={`Support — ${site.name}`}
  description={`Get help with ${site.name} — email ${site.supportEmail} about your account, a purchase, or a match that went wrong.`}
  canonical={`${site.url}/support`}
>
  <h1>Support</h1>
  <p class="doc-meta">
    {site.legalName} &middot; {site.mailingAddress} &middot;
    <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
  </p>
  <p>
    Write to <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>. We
    read every email and answer as soon as we can.
  </p>

  <h2>Tell us this and we can help faster</h2>
  <ul>
    <li>your display name in the game;</li>
    <li>the email address you sign in with;</li>
    <li>your phone and its software version; and</li>
    <li>what happened, and what you expected instead.</li>
  </ul>
  <p>A screenshot of the board or the error beats any description.</p>

  <h2>Coins or Gems missing after a purchase</h2>
  <p>
    Email us with the store receipt and we will put the balance right. Refunds
    themselves run through the App Store or Google Play, because that is who
    took the payment — start with them, then tell us if the balance is still
    wrong.
  </p>

  <h2>A match went wrong</h2>
  <p>
    If a game froze, disconnected, or scored in a way you did not expect, send
    the time it happened and your opponent's name. Every match is recorded, so
    we can replay it and see what the server did.
  </p>

  <h2>Someone is behaving badly</h2>
  <p>
    Send us a screenshot of an offensive display name or unsporting play. Our
    <a href="/terms">Terms</a> cover fair play and what happens to accounts that
    break them.
  </p>

  <h2>Closing your account</h2>
  <p>
    <a href="/delete-account">Delete Your Account</a> explains how to have your
    account and its data removed for good.
  </p>

  <h2>Your data</h2>
  <p>
    Our <a href="/privacy">Privacy Policy</a> covers what we hold and the rights
    you have over it. For data requests, write to
    <a href={`mailto:${site.privacyEmail}`}>{site.privacyEmail}</a>.
  </p>

  <h2>Contact us</h2>
  <ContactUs />
</LegalLayout>
