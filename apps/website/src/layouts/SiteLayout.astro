---
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'

interface Props {
  /** Document <title>, also feeds the Open Graph/Twitter title. */
  title: string
  /** Meta description, also feeds the Open Graph/Twitter description. */
  description: string
  /** Open Graph/Twitter description; defaults to the meta description. The
      legacy marketing pages shipped a distinct share blurb from the meta
      description, so allow pages to express that split. */
  ogDescription?: string
  /** Canonical URL override; defaults to the current page's URL. */
  canonical?: string
  /** Root-relative or absolute share image URL; defaults to the site background. */
  ogImage?: string
  /** Twitter card type; defaults to summary_large_image. */
  twitterCard?: string
  /** Mobile browser chrome color; defaults to the site background. */
  themeColor?: string
  /** <html lang>; defaults to "en". */
  lang?: string
}

const {
  title,
  description,
  ogDescription = description,
  canonical,
  ogImage = '/lobby/backgrounds/classic-green.webp',
  twitterCard = 'summary_large_image',
  themeColor = '#071120',
  lang = 'en',
} = Astro.props

// Astro.site comes from the `site` option in astro.config.mjs (set in Phase
// D7); the pre-D7 hardcoded fallback was dead code and has been removed.
const site = Astro.site
const canonicalUrl = canonical ? new URL(canonical, site).href : new URL(Astro.url.pathname, site).href
const ogImageUrl = new URL(ogImage, site).href
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / social share -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <div class="site-bg" aria-hidden="true"></div>
    <div class="site-shell">
      <SiteHeader />
      <main class="site-main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
