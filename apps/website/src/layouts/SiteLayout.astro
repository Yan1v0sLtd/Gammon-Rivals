---
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'

interface Props {
  /** Document <title>, also feeds the Open Graph/Twitter title. */
  title: string
  /** Meta description, also feeds the Open Graph/Twitter description. */
  description: string
  /** Open Graph/Twitter description; defaults to the meta description. Pages
      may want a distinct share blurb. */
  ogDescription?: string
  /** Canonical URL override; defaults to the current page's URL. */
  canonical?: string
  /** Root-relative or absolute share image URL; defaults to the site background. */
  ogImage?: string
  /** Twitter card type; defaults to summary_large_image. */
  twitterCard?: string
  /** Mobile browser chrome color; defaults to the site background. */
  themeColor?: string
  /** <html lang>; defaults to "en". */
  lang?: string
}

const {
  title,
  description,
  ogDescription = description,
  canonical,
  ogImage = '/lobby/backgrounds/classic-green.webp',
  twitterCard = 'summary_large_image',
  themeColor = '#071120',
  lang = 'en',
} = Astro.props

// Astro.site comes from the `site` option in astro.config.mjs.
const site = Astro.site
const canonicalUrl = canonical ? new URL(canonical, site).href : new URL(Astro.url.pathname, site).href
const ogImageUrl = new URL(ogImage, site).href
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / social share -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <div class="site-bg" aria-hidden="true"></div>
    <div class="site-shell">
      <SiteHeader />
      <main class="site-main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  .site-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image: url('/lobby/backgrounds/classic-green.webp');
    background-size: cover;
    background-position: center;
    filter: brightness(0.32) saturate(1.05);
  }
  .site-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 20%, rgba(28, 127, 185, 0.16), rgba(5, 12, 24, 0.94) 60%, rgba(2, 8, 16, 0.99));
  }

  .site-shell {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .site-main { flex: 1 1 auto; }
</style>
