---
import SiteLayout from './SiteLayout.astro'

interface Props {
  /** Document <title>, also feeds the Open Graph/Twitter title. */
  title: string
  /** Meta description, also feeds the Open Graph/Twitter description. */
  description: string
  /** Canonical URL override; defaults to the current page's URL. */
  canonical?: string
  /** Root-relative or absolute share image URL; defaults to the site background. */
  ogImage?: string
}

const props = Astro.props
---

<!-- Shared document wrapper for the legal pages (Privacy, Terms,
     delete-account). Content lands in the site-main slot via SiteLayout,
     framed by the centered doc-page/doc-panel shell. -->
<SiteLayout {...props}>
  <div class="doc-page">
    <article class="doc-panel">
      <slot />
    </article>
  </div>
</SiteLayout>
