---
// Shared site footer. Each page historically omitted its own link from the
// cross-links, so the current page is excluded entirely.
const { pathname } = Astro.url

// Astro's default build.format="directory" emits pages at trailing-slash
// URLs (/how-to-play/), so compare the normalized path to keep the exact
// match working (root "/" is left intact).
const current = pathname === '/' ? pathname : pathname.replace(/\/+$/, '')

const links = [
  { href: '/', label: 'Home' },
  { href: '/how-to-play', label: 'How to Play' },
  { href: '/terms', label: 'Terms' },
  { href: '/privacy', label: 'Privacy' },
]

const visibleLinks = links.filter(({ href }) => current !== href)
---

<footer class="site-footer">
  <span>© 2026 Gammon Rivals</span>
  {
    visibleLinks.map(({ href, label }) => (
      <Fragment>
        <span class="dot">·</span>
        <a href={href}>{label}</a>
      </Fragment>
    ))
  }
</footer>
