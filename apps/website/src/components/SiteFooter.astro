---
// Grouped site map. Every page is reachable from every page, and the current
// page is marked rather than hidden — with this many links, dropping one
// leaves a hole readers read as a mistake.
import { site } from '../config/site'

const { pathname } = Astro.url

// build.format="directory" emits trailing-slash URLs (/how-to-play/), so
// normalize the path to keep the exact match working (root "/" is intact).
const current = pathname === '/' ? pathname : pathname.replace(/\/+$/, '')

const groups = [
  {
    title: 'Game',
    links: [
      { href: '/', label: 'Home' },
      { href: '/how-to-play', label: 'How to Play' },
      { href: '/rules', label: 'Backgammon Rules' },
      { href: '/guides', label: 'Guides' },
      { href: '/glossary', label: 'Glossary' },
      { href: '/faq', label: 'FAQ' },
      { href: '/download', label: 'Get the Game' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/support', label: 'Support' },
      { href: '/fair-play', label: 'Fair Play' },
      { href: '/ranks-and-stakes', label: 'Ranks & Stakes' },
      { href: '/rewards', label: 'Rewards' },
      { href: '/community-rules', label: 'Community Rules' },
      { href: '/press', label: 'Press' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/terms', label: 'Terms' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/responsible-play', label: 'Responsible Play' },
      { href: '/delete-account', label: 'Delete Account' },
      { href: '/licenses', label: 'Licenses' },
      { href: '/security', label: 'Security' },
      { href: '/accessibility', label: 'Accessibility' },
    ],
  },
]
---

<footer class="site-footer">
  <nav class="footer-groups" aria-label="Footer">
    {
      groups.map(({ title, links }) => (
        <div class="footer-group">
          <h2>{title}</h2>
          <ul>
            {links.map(({ href, label }) => (
              <li>
                <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
  <div class="footer-base">
    <span>© {new Date().getFullYear()} {site.tradeName}</span>
    <p class="footer-note">{site.legalName} &middot; {site.mailingAddress}. {site.disclaimer}</p>
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
    padding: 2.2rem clamp(1rem, 3vw, 2.5rem) 2rem;
    border-top: 1px solid rgba(246, 215, 112, 0.14);
    font-size: 0.78rem;
    color: var(--site-cream-faint);
    text-align: center;
  }

  .footer-groups {
    width: 100%;
    max-width: 56rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.4rem 2rem;
  }

  .footer-group h2 {
    margin: 0 0 0.6rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--site-gold);
  }
  .footer-group ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.4rem; }

  .site-footer a { color: inherit; text-decoration: none; }
  .site-footer a:hover { color: var(--site-gold); }
  .site-footer a[aria-current='page'] { color: var(--site-gold); }

  .footer-base { display: grid; gap: 0.5rem; justify-items: center; }
  .footer-note {
    margin: 0;
    max-width: 46rem;
    font-size: 0.72rem;
    line-height: 1.6;
    opacity: 0.85;
  }
</style>
