---
// Shared by Privacy (Section 15), Terms (Section 30), Delete Account, About,
// and Support so every contact block renders byte-identical markup.
import { site } from '../config/site'
---
<p>
  <strong>{site.legalName}</strong><br />
  Email: <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a><br />
  Address: {site.mailingAddress}<br />
  Website: <a href={site.url}>{site.url.replace('https://', '')}</a>
</p>
