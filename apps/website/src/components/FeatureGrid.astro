---
// Lobby icons are shared/DB-seeded assets — keep their stable public URLs,
// never copy them into brand-assets/imported/.
// Card 3's /terms anchor stays in the body string and renders with set:html
// so the inline markup survives verbatim.
const features = [
  {
    icon: '/lobby/icons/trophy.webp',
    title: 'Difficulty tiers',
    body: 'Pick a tier that matches your skill and start a match — from casual games to tougher, higher-stakes tables.',
  },
  {
    icon: '/lobby/icons/online-players.webp',
    title: 'Real opponents, or AI',
    body: "Matchmaking pairs you with another player when one's available, and with an AI opponent when it isn't — so there's always a game to play.",
  },
  {
    icon: '/lobby/icons/gold-coin.webp',
    title: 'Coins & Gems',
    body: 'Every match plays for in-game Coins and Gems — virtual currency used only inside the app, with no cash value. See our <a href="/terms" style="color: var(--site-gold);">Terms</a> for details.',
  },
  {
    icon: '/lobby/icons/gem.webp',
    title: 'Board themes',
    body: 'Unlock new board designs as you play and personalize your table.',
  },
  {
    icon: '/lobby/icons/rewards-gift.webp',
    title: 'Daily & hourly rewards',
    body: 'Come back for daily missions, an hourly bonus wheel, and streak rewards.',
  },
  {
    icon: '/lobby/icons/friends.webp',
    title: 'Level up',
    body: 'Earn XP from every match and climb through ranks as your profile grows.',
  },
]
---

<div class="feature-grid">
  {
    features.map(({ icon, title, body }) => (
      <div class="feature-card">
        <img src={icon} alt="" loading="lazy" />
        <h3>{title}</h3>
        <p set:html={body} />
      </div>
    ))
  }
</div>

<style>
  .feature-grid {
    max-width: 64rem;
    margin: 0 auto 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.1rem;
  }

  .feature-card {
    background: var(--site-panel-bg);
    border: 1px solid var(--site-panel-border);
    border-radius: 0.9rem;
    padding: 1.4rem 1.3rem;
  }
  .feature-card img { width: 2.5rem; height: 2.5rem; object-fit: contain; margin-bottom: 0.8rem; }
  .feature-card h3 { margin: 0 0 0.4rem; color: var(--site-gold); font-size: 1.02rem; }
  .feature-card p { margin: 0; font-size: 0.88rem; line-height: 1.6; color: var(--site-cream-dim); }
</style>
