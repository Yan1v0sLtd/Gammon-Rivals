{
  "name": "backgammon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/game/vite.config.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "build": "tsc -b apps/game/tsconfig.json tsconfig.node.json && cross-env NODE_ENV=production vite build --config apps/game/vite.config.ts",
    "build:admin": "tsc -b apps/admin/tsconfig.json tsconfig.node.json && cross-env NODE_ENV=production vite build --config apps/admin/vite.config.ts",
    "build:all": "npm run check:boundaries && npm run build && npm run build:admin",
    "check:boundaries": "node scripts/check-app-boundaries.mjs",
    "lint": "eslint .",
    "build:shared-engine": "node scripts/build-shared-engine.mjs",
    "build:shared-ai": "node scripts/build-shared-ai.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:build": "npm run build && npx cap build android",
    "android:assets": "node scripts/render-android-assets.mjs && npx @capacitor/assets generate --android",
    "android:reload": "node scripts/android-reload.mjs",
    "preview": "vite preview",
    "sim": "node scripts/run-economy-sim.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "overrides": {
    "sharp": "0.35.3",
    "uuid": "11.1.1",
    "tar": "^7.5.20"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.3.40",
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/supabase-js": "^2.112.2",
    "cannon-es": "^0.20.0",
    "capacitor-plugin-cdv-purchase": "^13.18.0",
    "cordova-plugin-purchase": "^13.18.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@miskamyasa/eslint-config": "^1.1.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "cross-env": "10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.26",
    "sharp": "0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
