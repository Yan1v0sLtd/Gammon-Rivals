VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set in the game deployment so old /admin links open the Back Office origin.
VITE_ADMIN_APP_URL=http://127.0.0.1:5175
# Set in the admin deployment so "Back to lobby" opens the player app.
VITE_GAME_APP_URL=http://127.0.0.1:5174
# Google Web OAuth client ID (the same one configured in the Supabase Google
# provider). Required for native Android Google sign-in — MUST be present when
# building a self-contained (bundled, non-server.url) AAB, or the app throws
# "Google sign-in is not configured on this build". Public value; safe to share.
VITE_GOOGLE_WEB_CLIENT_ID=
