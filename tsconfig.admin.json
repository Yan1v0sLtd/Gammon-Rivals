{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.admin.tsbuildinfo",
    "paths": {
      "@shared/*": ["./packages/shared/src/*"],
      "@board-preview/*": ["./packages/board-preview/src/*"],
      "@board/*": ["./src/board/*"],
      "@engine/*": ["./src/engine/*"]
    }
  },
  "include": [
    "apps/admin/src",
    "packages/board-preview/src",
    "packages/shared/src",
    "src/build-info.d.ts"
  ]
}
